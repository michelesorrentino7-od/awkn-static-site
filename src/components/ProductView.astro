---
import Base from "../layouts/Base.astro";
import type { Product } from "../data/site";
import { products } from "../data/site";
import ProductCard from "./ProductCard.astro";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const others = products.filter((item) => item.file !== product.file);
---

<Base
  title={`${product.name} ${product.size} | AWKN® Korean Apothecary`}
  description={`${product.name} ${product.size}. ${product.note}`}
>
  <article class="product-page">
    <div class="stage">
      <img src={product.image} alt={`${product.name} ${product.size}`} />
    </div>
    <div>
      <p class="kicker">Night Owl · Liver support shot</p>
      <h1>{product.size}</h1>
      <p class="price">
        <strong>{product.price}</strong>
        {product.compare && <s>{product.compare}</s>}
      </p>
      <p class="unit">{product.unit}</p>
      <p class="lede">{product.note}</p>
      <div class="buy-row">
        <a class="button" href={product.buy}>Buy on theawkn.com</a>
        <a class="button ghost" href="ingredients.html">See the formula</a>
      </div>
      <div class="steps stacked">
        <article class="step">
          <span>01</span>
          <h3>Before</h3>
          <p>One shot towards the start of the evening.</p>
        </article>
        <article class="step">
          <span>02</span>
          <h3>If it runs long</h3>
          <p>A second shot before bed. No more than twice a day.</p>
        </article>
        <article class="step">
          <span>03</span>
          <h3>The morning</h3>
          <p>Show up for the workday. This is a head start, not a cure.</p>
        </article>
      </div>
    </div>
  </article>
  <section class="section">
    <div class="section-head">
      <h2>Also in the range</h2>
    </div>
    <div class="product-grid">
      {others.map((item) => <ProductCard product={item} />)}
    </div>
  </section>
</Base>
