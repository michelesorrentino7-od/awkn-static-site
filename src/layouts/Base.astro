---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { photos } from "../data/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={photos.favicon} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <p class="announce">Korean apothecary for the night after · 4.9/5 from verified reviews</p>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <script>
      import { mountOwl } from "../scripts/owl-mascot.mjs";
      import directions from "../assets/owl/directions.webp?url";
      import reactions from "../assets/owl/reactions.webp?url";
      import takeoff from "../assets/owl/takeoff.png?url";
      import flight from "../assets/owl/flight.png?url";
      import landing from "../assets/owl/landing.png?url";

      mountOwl({ directions, reactions, takeoff, flight, landing });
    </script>
  </body>
</html>
